# Kopirajte ovaj fajl u .env.local i upišite vrednosti. Na Vercelu ih unesite u
# Project Settings > Environment Variables. Obe vrednosti su javne (vide se u pregledaču).

# Adresa servisa koji prima upite sa kontakt formulara.
#   Formspree:  https://formspree.io/f/<id formulara>
#   Web3Forms:  https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# Samo za Web3Forms: pristupni ključ. Za Formspree ostavite prazno.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Google Tag Manager, oblik GTM-XXXXXXX. Učitava se tek kada posetilac prihvati
# analitičke ili marketinške kolačiće. Bez ove vrednosti se ne učitava ništa.
NEXT_PUBLIC_GTM_ID=
